@startuml DiagramaArquitecturaCapas
!theme plain
skinparam backgroundColor #FEFEFE
skinparam classBackgroundColor #F0F0F0
skinparam classBorderColor #333333
skinparam arrowColor #333333

title Diagrama de Arquitectura en Capas
subtitle PC Hardware Marketplace

package "Capa de Presentación (API REST)" #CCFFCC {
    component [Controllers]
    component [DTOs]
}

package "Capa de Negocio (Services)" #CCCCFF {
    component [ProductoService]
    component [CarritoService]
    component [VentasService]
    component [UsuarioService]
    component [ReviewService]
    component [OrdenService]
}

package "Capa de Persistencia (Repositories)" #FFCCCC {
    component [ProductoRepository]
    component [CarritoRepository]
    component [VentasRepository]
    component [UsuarioRepository]
    component [ReviewRepository]
    component [OrdenRepository]
}

package "Capa de Datos" #FFFFCC {
    database [Base de Datos\nSQL]
}

' Relaciones entre capas
[Controllers] --> [DTOs] : usa
[Controllers] --> [ProductoService] : invoca
[Controllers] --> [CarritoService] : invoca
[Controllers] --> [VentasService] : invoca
[Controllers] --> [UsuarioService] : invoca
[Controllers] --> [ReviewService] : invoca
[Controllers] --> [OrdenService] : invoca

[ProductoService] --> [ProductoRepository] : utiliza
[CarritoService] --> [CarritoRepository] : utiliza
[VentasService] --> [VentasRepository] : utiliza
[UsuarioService] --> [UsuarioRepository] : utiliza
[ReviewService] --> [ReviewRepository] : utiliza
[OrdenService] --> [OrdenRepository] : utiliza

[ProductoRepository] --> [Base de Datos\nSQL] : accede
[CarritoRepository] --> [Base de Datos\nSQL] : accede
[VentasRepository] --> [Base de Datos\nSQL] : accede
[UsuarioRepository] --> [Base de Datos\nSQL] : accede
[ReviewRepository] --> [Base de Datos\nSQL] : accede
[OrdenRepository] --> [Base de Datos\nSQL] : accede

@enduml